<Window x:Class="WindowScatter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MissionView"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        AllowsTransparency="False"
        Background="Black"
        PreviewKeyDown="Window_KeyDown"
        Topmost="True">

    <Canvas x:Name="RenderCanvas" ClipToBounds="True">
        <!-- Desktop capture or wallpaper fallback. -->
        <Image x:Name="BackgroundImage" 
               Panel.ZIndex="0"/>

        <!-- Reserved overlay layer for future glass effects. -->
        <Border x:Name="FrostedGlass"
                Panel.ZIndex="1"
                Background="#80FFFFFF"
                Opacity="0"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>
        <!-- Dark overlay for contrast. -->
        <Border x:Name="DimOverlay"
                Panel.ZIndex="2"
                Background="#60000000"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>

        <Canvas x:Name="ChromeCanvas"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}">
            <Canvas x:Name="ScatterCanvas"
                    Background="Transparent"
                    MouseLeftButtonDown="ScatterCanvas_MouseLeftButtonDown"
                    Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>
            <Border x:Name="DropHint" Canvas.Left="8" Canvas.Top="72" BorderBrush="Yellow"
                    BorderThickness="2" CornerRadius="8" Visibility="Hidden" IsHitTestVisible="False"/>
            <TextBlock x:Name="EmptyMessage" Text="No windows on this display.&#10;Drop a window here."
                       Foreground="White" FontSize="16" TextAlignment="Center"
                       IsHitTestVisible="False" Visibility="Hidden"/>
            <Button x:Name="DesktopButton" Width="44" Height="44" Padding="6"
                    Canvas.Left="16" Canvas.Top="16" Panel.ZIndex="1"
                    Click="DesktopButton_Click"
                    ToolTip="Show desktop; press the activation shortcut again to restore windows."
                    AutomationProperties.Name="Show desktop">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="#202020" BorderBrush="White"
                                BorderThickness="2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#404040"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFF00"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Width="24" Height="24" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M2,3 H22 V17 H2 Z M12,17 V21 M8,21 H16"
                      Focusable="False" IsHitTestVisible="False"/>
            </Button>
            <TextBlock x:Name="MoveStatus" Canvas.Left="72" Canvas.Top="28" Foreground="White"
                       FontSize="14" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Canvas>
    </Canvas>
</Window>
