    <Compile Include="../../Infrastructure/Windows/WindowSurfacePolicy.cs" Link="WindowSurfacePolicy.cs" />
    <Compile Include="../../Infrastructure/Windows/MonitorHelper.cs" Link="MonitorHelper.cs" />
    <Compile Include="../../Infrastructure/Windows/WindowEnumerator.cs" Link="WindowEnumerator.cs" />
    <Compile Include="../../Infrastructure/Windows/WindowTransfer.cs" Link="WindowTransfer.cs" />
    <Compile Include="../../Infrastructure/Windows/WindowStacking.cs" Link="WindowStacking.cs" />
  </ItemGroup>
