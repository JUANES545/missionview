<Window x:Class="WindowScatter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowScatter"
        Title="MissionView"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        AllowsTransparency="False"
        Background="Black"
        PreviewKeyDown="Window_KeyDown"
        Topmost="True"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Canvas x:Name="RenderCanvas" ClipToBounds="True">
        <!-- Desktop capture or wallpaper fallback. -->
        <Image x:Name="BackgroundImage" 
               Panel.ZIndex="0"/>

        <!-- Reserved layer; the backdrop below is a scrim, not acrylic. -->
        <Border x:Name="FrostedGlass"
                Panel.ZIndex="1"
                Background="#80FFFFFF"
                Opacity="0"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>
        <!-- Dark overlay for contrast. -->
        <Border x:Name="DimOverlay"
                Panel.ZIndex="2"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#A0202522"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Canvas x:Name="ChromeCanvas"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="TextElement.Foreground" Value="#F3F5F4"/>
                    <Setter Property="TextElement.FontFamily" Value="Segoe UI Variable, Segoe UI"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <local:OverviewThumbnailCanvas x:Name="ScatterCanvas"
                    Background="Transparent"
                    MouseLeftButtonDown="ScatterCanvas_MouseLeftButtonDown"
                    Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight}"/>
            <TextBlock x:Name="EmptyMessage" Text="No windows on this display.&#10;Drop a window here."
                       FontSize="16" TextAlignment="Center"
                       IsHitTestVisible="False" Visibility="Hidden"/>
            <local:OverviewDesktopButton x:Name="DesktopButton" Width="44" Height="44" Padding="6"
                    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Canvas}}"
                    Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}"
                    Canvas.Left="16" Canvas.Top="16" Panel.ZIndex="1"
                    Click="DesktopButton_Click"
                    ToolTip="Show desktop; press the activation shortcut again to restore windows."
                    AutomationProperties.Name="Show desktop">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="#202020" BorderBrush="White"
                                BorderThickness="2" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#404040"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Width="24" Height="24" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M2,3 H22 V17 H2 Z M12,17 V21 M8,21 H16"
                      Focusable="False" IsHitTestVisible="False"/>
            </local:OverviewDesktopButton>
            <TextBlock x:Name="MoveStatus" Canvas.Left="72" Canvas.Top="28"
                       FontSize="14" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel x:Name="SearchPanel" Panel.ZIndex="1" ClipToBounds="True"
                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <StackPanel.Resources>
                    <Style x:Key="SearchSurface" TargetType="Border">
                        <Setter Property="Background" Value="#292A2E"/>
                        <Setter Property="BorderBrush" Value="#797B85"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#E4E6ED"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocusWithin}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                <Border Style="{StaticResource SearchSurface}" CornerRadius="12" BorderThickness="2" Padding="10,0" MinHeight="48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Canvas}}"
                              StrokeThickness="2" StrokeEndLineCap="Round" IsHitTestVisible="False"
                              Data="M15,9 A6,6 0 1 1 3,9 A6,6 0 1 1 15,9 M13.5,13.5 L19,19"/>
                        <local:OverviewSearchBox x:Name="SearchBox" Grid.Column="1" FontSize="18" Padding="8,0"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Canvas}}"
                                 CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                                 IsTabStop="False" TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Search windows by title or application"
                                 AutomationProperties.HelpText="Type to filter. Use Tab or arrow keys to select a result, Enter to switch, and Escape to clear."/>
                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#3A3B41"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Esc" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SearchSurface}" CornerRadius="6" Margin="0,5,0,0" IsHitTestVisible="False"
                        Visibility="{Binding ElementName=SearchStatusText, Path=Visibility}">
                    <TextBlock x:Name="SearchStatusText" Visibility="Collapsed" TextAlignment="Center"
                               FontSize="13" Padding="4" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </StackPanel>
        </Canvas>
    </Canvas>
</Window>
