<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MissionView</AssemblyName>
    <RootNamespace>WindowScatter</RootNamespace>
    <Title>MissionView</Title>
    <Product>MissionView</Product>
    <Description>A Mission Control-style window overview for Windows.</Description>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\branding\MissionView.ico</ApplicationIcon>
    <DefineConstants Condition="'$(EnumerationDiagnostics)' == 'true'">$(DefineConstants);ENUMERATION_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\branding\MissionView.ico" LogicalName="MissionView.TrayIcon.ico" />
    <!-- standalone spike project lives under spike/; keep it out of this compilation -->
    <Compile Remove="spike\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="Infrastructure\Windows\Experimental\**\*.cs" />
    <None Remove="spike\**\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.20348" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its implicit usings out
         so System.Windows.Forms/System.Drawing names don't clash with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  

</Project>
